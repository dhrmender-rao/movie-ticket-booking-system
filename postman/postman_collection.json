              "raw": "{{baseUrl}}/api/movies/{{movieId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movies", "{{movieId}}"]
            }
          }
        },
        {
          "name": "Get Shows by City",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cities/{{cityId}}/shows",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cities", "{{cityId}}", "shows"],
              "query": [
                { "key": "movieId", "value": "{{movieId}}", "disabled": true },
                { "key": "date", "value": "2026-07-01", "disabled": true }
              ]
            },
            "description": "Optional query params: `movieId` and `date` (yyyy-MM-dd) for filtering."
          }
        },
        {
          "name": "Get Shows by City + Movie Filter",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cities/{{cityId}}/shows?movieId={{movieId}}&date=2026-07-01",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cities", "{{cityId}}", "shows"],
              "query": [
                { "key": "movieId", "value": "{{movieId}}" },
                { "key": "date", "value": "2026-07-01" }
              ]
            }
          }
        },
        {
          "name": "Get Show by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/shows/{{showId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shows", "{{showId}}"]
            }
          }
        },
        {
          "name": "Get Seat Map for Show",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const seats = pm.response.json();",
                  "    const available = seats.filter(s => s.status === 'AVAILABLE');",
                  "    if (available.length >= 2) {",
                  "        pm.collectionVariables.set('showSeatId1', available[0].id);",
                  "        pm.collectionVariables.set('showSeatId2', available[1].id);",
                  "        console.log('showSeatId1=' + available[0].id + ', showSeatId2=' + available[1].id);",
                  "    } else if (available.length === 1) {",
                  "        pm.collectionVariables.set('showSeatId1', available[0].id);",
                  "        console.log('Only 1 available seat: showSeatId1=' + available[0].id);",
                  "    } else {",
                  "        console.warn('No available seats found!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/shows/{{showId}}/seats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shows", "{{showId}}", "seats"]
            },
            "description": "Lists all seats with their current status (AVAILABLE / HELD / BOOKED).\nThe test script automatically extracts the first two AVAILABLE seat IDs into `showSeatId1` and `showSeatId2`."
          }
        }
      ]
    },
    {
      "name": "Customer — Booking Flow",
      "description": "Requires `customerToken`. Run in order:\n1. Hold Seats\n2. Create Booking\n3. Pay\n4. (Optional) Cancel Booking",
      "item": [
        {
          "name": "1. Hold Seats",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showSeatIds\": [{{showSeatId1}}, {{showSeatId2}}]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/shows/{{showId}}/seats/hold",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shows", "{{showId}}", "seats", "hold"]
            },
            "description": "Holds the selected seats for 10 minutes. Must book before hold expires."
          }
        },
        {
          "name": "2. Create Booking (No Discount)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('bookingId', json.id);",
                  "    console.log('bookingId set to ' + json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
